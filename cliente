
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <netinet/in.h>
#include <netdb.h>
#include <string.h>
#include <sys/types.h>
#include <sys/socket.h>
#include <arpa/inet.h>
#include <errno.h>

#define KTAM 20
#define KPUERTO 9999

/*
AF_INET es una familia de direcciones que se utiliza para
designar el tipo de direcciones con las que su socket puede
comunicarse (en este caso, direcciones de Protocolo de
Internet IPv4).

Cuando crea un socket, debe especificar su familia de
direcciones, y luego solo puede usar direcciones de ese
tipo con el socket.
*/

// ./Cliente 127.0.0.1
// Es la direccion de loopback, sobre la propia maquina.

int main(int argc, char *argv[]) {

    char buffer[KTAM];
    int sock;
    ssize_t tam;
    struct sockaddr_in serv_addr;

    // COMPROBAR ARGUMENTOS
    if (argc != 2) {

        fprintf(stderr, "Uso: %s <IP_del_servidor>\n", argv[0]);
        return 1;
    }

    // CREAR SOCKET
    sock = socket(AF_INET, SOCK_STREAM, 0);

    if (sock < 0) {

        perror("Error. No se pudo crear socket");
        return 1;

    }
    else {

        // PREPARAR DIRECCION DEL SERVIDOR
        bzero((char *) &serv_addr, sizeof(serv_addr));

        serv_addr.sin_port = htons(KPUERTO);
        serv_addr.sin_family = AF_INET;
        serv_addr.sin_addr.s_addr = inet_addr(argv[1]);

        // CONECTAR CON EL SERVIDOR
        if (connect(sock, (struct sockaddr *) &serv_addr,
                    sizeof(serv_addr)) < 0) {

            perror("Error. No se pudo conectar al servidor");
            close(sock);
            return 1;

        }
        else {

            printf("Conexion establecida con el servidor\n\n");

            // RECIBIR EL CONTENIDO DEL FICHERO
            do {

                tam = read(sock, buffer, KTAM);

                if (tam > 0) {

                    // Mostrar los bytes recibidos
                    ssize_t escritos = 0;

                    while (escritos < tam) {

                        ssize_t resultado = write(
                            STDOUT_FILENO,
                            buffer + escritos,
                            tam - escritos
                        );

                        if (resultado < 0) {

                            if (errno == EINTR)
                                continue;

                            perror("Error al mostrar los datos");
                            close(sock);
                            return 1;
                        }

                        if (resultado == 0)
                            break;

                        escritos += resultado;
                    }

                }

            } while (tam > 0);

            if (tam < 0)
                perror("Error al leer del socket");

            // CERRAR SOCKET
            close(sock);
        }
    }

    return 0;
}

